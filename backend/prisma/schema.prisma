generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  PAUSED
  ENDED
  ARCHIVED
}

/** Découvrabilité : PRIVATE = hors Discover / noindex ; PUBLIC = éligible Discover + SEO. */
enum EventVisibility {
  PRIVATE
  PUBLIC
}

enum PollStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum PollType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  CONTEST_ENTRY
  YES_NO
  RATING
  RANKING
  OPEN_TEXT
  WORD_CLOUD
  QUIZ
}

enum LiveState {
  WAITING
  VOTING
  RESULTS
  PAUSED
  FINISHED
}

/** Affichage écran de projection (indépendant de l’ouverture du vote) */
enum DisplayState {
  QUESTION
  RESULTS
  BLACK
  WAITING
}

/** Vote ouvert ou fermé sur le sondage actif */
enum VoteState {
  OPEN
  CLOSED
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

enum ActivationPlanType {
  FUN
  EVENT
}

/** Lot D — profil organisateur (Particulier / Organisation). */
enum OrganizerProfileType {
  PERSONAL
  ORGANIZATION
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  /** Null si compte Google-only (mot de passe non utilisé). */
  passwordHash String?
  provider     AuthProvider @default(CREDENTIALS)
  googleId     String?      @unique
  eventCredits Int          @default(0)
  role String @default("USER")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  events       Event[]
  contestDraws ContestDraw[] @relation("ContestDrawCreatedBy")
  reportShareTokens AccountReportShareToken[]
  payments          Payment[]
  eventActivations  EventActivation[]
  landingMessages   EventLandingMessage[]
  organizerProfiles OrganizerProfile[]
  eventFavorites    EventFavorite[]
  organizerFollows  OrganizerFollow[]
  eventGuestAccesses EventGuestAccess[]
  passwordResetTokens PasswordResetToken[]
}

/** Jetons de réinitialisation mot de passe (usage unique, hashés). */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Event {
  id           String      @id @default(cuid())
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  /** Texte optionnel régie + salle /join */
  description  String?
  /** URL ou chemin absolu /uploads/… (logo salle) */
  logoUrl      String?
  /** Image de fond salle /join */
  backgroundUrl String?
  /** Accent hex (#RRGGBB) */
  primaryColor String?
  /** dark | light | auto — thème base salle /join */
  themeMode    String?
  /** low | medium | strong — opacité overlay sur image de fond */
  backgroundOverlayStrength String?
  /** Fond uni (#RRGGBB) pour la salle /join lorsqu’aucune image de fond */
  roomBackgroundColor String?
  /** Bloc infos/CTA optionnel affiché dans la salle publique */
  infoSectionTitle String?
  infoSectionText String?
  infoPrimaryCtaLabel String?
  infoPrimaryCtaUrl String?
  infoSecondaryCtaLabel String?
  infoSecondaryCtaUrl String?
  /** Afficher les infos aussi quand l'événement est terminé */
  infoShowOnFinished Boolean @default(true)
  slug         String      @unique
  status       EventStatus @default(DRAFT)
  /** Privé par défaut. N’altère pas /join ni le vote. Landing non gateée en Lot A. */
  visibility   EventVisibility @default(PRIVATE)
  /** Ville structurée (Discover) — ne pas dériver automatiquement de landingVenue. */
  city         String?
  /** Date/heure de début structurée (Discover). Obligatoire pour être listé. */
  startsAt     DateTime?
  /** Thème métier principal (catalogue Theme) — obligatoire pour Discover. */
  primaryThemeId   String?
  primaryTheme     Theme?  @relation("EventPrimaryTheme", fields: [primaryThemeId], references: [id], onDelete: SetNull)
  /** Thème secondaire facultatif — distinct du principal. */
  secondaryThemeId String?
  secondaryTheme   Theme?  @relation("EventSecondaryTheme", fields: [secondaryThemeId], references: [id], onDelete: SetNull)
  /** Profil organisateur (Lot D) — requis pour Discover, optionnel pour le live privé. */
  organizerProfileId String?
  organizerProfile   OrganizerProfile? @relation(fields: [organizerProfileId], references: [id], onDelete: SetNull)
  liveState    LiveState   @default(WAITING)
  /** Affichage écran salle : question / résultats / noir / attente */
  displayState DisplayState @default(WAITING)
  /** Affichage projection régie (optionnel) — si null, fallback sur displayState */
  screenDisplayState DisplayState?
  /** Participants peuvent voter (indépendant de displayState) */
  voteState    VoteState    @default(CLOSED)
  /** Affichage automatique des résultats après fermeture du vote (délai en secondes) */
  autoReveal             Boolean   @default(true)
  autoRevealDelaySec     Int       @default(5)
  /** Quand défini, projection / public : compte à rebours jusqu’à passage display RESULTS */
  autoRevealShowResultsAt DateTime?
  activePollId String?
  /** Chrono question (V1 informatif, piloté par la régie) */
  questionTimerTotalSec        Int?
  questionTimerAccumulatedSec  Int       @default(0)
  questionTimerStartedAt       DateTime?
  questionTimerIsPaused        Boolean   @default(true)
  /** Mode test / réel : l'événement n'est consommable qu'une seule fois pour un usage réel. */
  isLiveConsumed Boolean @default(false)
  /** Date du démarrage réel (mode réel en premier lancement). */
  consumedAt DateTime?
  /** Verrou après fin réelle : empêche tout rejouage / relance en usage réel. */
  isLocked Boolean @default(false)
  /** Limite business de participants uniques (voterSessionId) sur l'événement. */
  participantsLimit Int @default(500)
  /** Formule activée au passage en mode réel (FUN / EVENT). */
  eventPlanType ActivationPlanType?
  /** Landing publique `/e/[slug]` (vitrine + galerie photo). */
  landingEnabled     Boolean @default(false)
  landingCoverUrl    String?
  landingTitle       String?
  landingDescription String?
  /** Présentation ✨ L'événement — textes libres optionnels (pas de timezone). */
  landingEventDate String?
  landingVenue     String?
  landingHours     String?
  /** Message organisateur (présentation) — corps multi-paragraphes. */
  landingIntroTitle String?
  landingIntroBody  String?
  /** IDs ordonnés de photos showcase illustrant le message (JSON string[]). */
  landingIntroPhotoIds Json?
  /** Message de clôture / remerciements — affiché uniquement après l’événement. */
  landingThanksTitle String?
  landingThanksBody  String?
  landingThanksPhotoIds Json?
  /** Après l’événement : quels types restent visibles dans le fil (défaut = comportement actuel). */
  landingKeepPhotosAfter   Boolean @default(true)
  landingKeepResultsAfter  Boolean @default(true)
  landingKeepMessagesAfter Boolean @default(true)
  /**
   * Lot F — accès souvenirs sur invitation (soft-gate).
   * false = comportement historique (Landing /e accessible par slug même si PRIVATE).
   * true = souvenirs protégés : auth + grant (code) requis, hors organisateur.
   */
  inviteEnabled Boolean @default(false)
  /** Hash bcrypt du code d’accès (jamais de code en clair en base / API list). */
  inviteCodeHash String?
  inviteCodeUpdatedAt DateTime?
  /**
   * Lot F — médias Landing servis via Cloudinary authenticated + URL signées.
   * Activé seulement après migration réussie des publicIds existants.
   */
  mediaProtectionEnabled Boolean @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  polls Poll[]
  leads LeadCapture[]
  contestDraws ContestDraw[]
  landingPhotos         EventLandingPhoto[]
  landingShowcasePhotos EventLandingShowcasePhoto[]
  landingMessages       EventLandingMessage[]
  landingProgramItems   EventLandingProgramItem[]
  guestAccesses         EventGuestAccess[]

  @@index([userId])
  @@index([visibility])
  @@index([visibility, startsAt])
  @@index([visibility, city])
  @@index([primaryThemeId])
  @@index([secondaryThemeId])
  @@index([organizerProfileId])
  @@index([inviteEnabled])

  favorites EventFavorite[]
}

/**
 * Lot F — invitation acceptée (compte → événement privé protégé).
 * Le renouvellement du code ne révoque pas ces grants.
 */
model EventGuestAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId, grantedAt])
  @@index([eventId])
}

/**
 * Lot D — identité publique organisateur.
 * PERSONAL : au plus un par compte (contrainte applicative).
 * ORGANIZATION : plusieurs par compte.
 * Ne jamais dériver displayName de l’e-mail automatiquement.
 */
model OrganizerProfile {
  id          String               @id @default(cuid())
  ownerUserId String
  owner       User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  type        OrganizerProfileType
  slug        String               @unique
  displayName String
  bio         String?
  /** Photo (particulier) ou logo (organisation). */
  imageUrl    String?
  websiteUrl  String?
  /** false = hors annuaire / API publique (typique profil perso). */
  isPublic    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  events  Event[]
  follows OrganizerFollow[]

  @@index([ownerUserId, type])
  @@index([isPublic, type])
}

/**
 * Lot E — favori événement (compte → événement public).
 * L’unicité userId+eventId empêche les doublons.
 * Un événement redevenu privé reste en base mais est filtré des listes affichées.
 */
model EventFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId, createdAt])
  @@index([eventId])
}

/**
 * Lot E — suivi d’un profil organisateur public.
 * Libellé produit : « Organisateurs suivis » (pas « Abonnements »).
 * Profil non public → filtré des listes affichées ; aucun droit supplémentaire.
 */
model OrganizerFollow {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizerProfileId String
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@unique([userId, organizerProfileId])
  @@index([userId, createdAt])
  @@index([organizerProfileId])
}

/** Catalogue thèmes métier Discover (Lot B) — distinct de themeMode salle. */
model Theme {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventsPrimary   Event[] @relation("EventPrimaryTheme")
  eventsSecondary Event[] @relation("EventSecondaryTheme")

  @@index([active, sortOrder])
}

/** Étape de programme Landing (heure + titre), ordre chronologique. */
model EventLandingProgramItem {
  id        String   @id @default(cuid())
  eventId   String
  timeLabel String
  title     String
  /** Minutes depuis minuit quand parsable ; sinon grand pour fin de liste. */
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder, createdAt])
}

/**
 * Photos landing orga (galerie événement et/ou illustration messages).
 * showInGallery=false → upload direct message, hors galerie publique.
 */
model EventLandingShowcasePhoto {
  id                 String   @id @default(cuid())
  eventId            String
  url                String
  cloudinaryPublicId String?
  /** Légende facultative (orga). */
  caption            String?
  /** false = photo message-only (pas dans la Galerie de l'événement). */
  showInGallery      Boolean  @default(true)
  createdAt          DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([eventId, showInGallery])
}

/** Photos galerie landing (upload organisateur, pas de vidéo V1). */
model EventLandingPhoto {
  id                 String   @id @default(cuid())
  eventId            String
  url                String
  cloudinaryPublicId String?
  /** Légende facultative (orga, y compris après publication). */
  caption            String?
  createdAt          DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  likes EventLandingPhotoLike[]

  @@index([eventId, createdAt])
}

/** Message court organisateur — fil chronologique landing. */
model EventLandingMessage {
  id              String   @id @default(cuid())
  eventId         String
  body            String
  /** Masqué du fil public (conservé en base pour l’orga). */
  hidden          Boolean  @default(false)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([eventId, hidden, createdAt])
}

/** Like anonyme sur un Moment live (visitorKey = voterSessionId client). */
model EventLandingPhotoLike {
  id          String   @id @default(cuid())
  photoId     String
  visitorKey  String
  createdAt   DateTime @default(now())

  photo EventLandingPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, visitorKey])
  @@index([photoId])
}

model Poll {
  id        String     @id @default(cuid())
  eventId   String
  title     String
  question  String
  contestPrize String?
  contestWinnerCount Int @default(1)
  type      PollType
  quizRevealed       Boolean  @default(false)
  leadEnabled         Boolean  @default(false)
  leadTriggerOptionId String?
  /** L1 formulaires : définition JSON (null = hors Lead/Concours ou pré-backfill). */
  formDefinition     Json?
  formTemplateKey    String?
  formSchemaVersion  Int       @default(1)
  status    PollStatus @default(DRAFT)
  order     Int        @default(0)
  /** Orga : masquer ce résultat du fil landing (publication auto sinon). */
  landingResultHidden Boolean @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   Vote[]
  leads   LeadCapture[]
  contestDraws ContestDraw[]
  contestWinners ContestDrawWinner[]
}

model ContestDraw {
  id                   String              @id @default(cuid())
  pollId               String
  eventId              String
  createdByUserId      String
  winnerCount          Int                 @default(1)
  eligibleCountAtDraw  Int
  createdAt            DateTime            @default(now())

  poll                 Poll                @relation(fields: [pollId], references: [id], onDelete: Cascade)
  event                Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdByUser        User                @relation("ContestDrawCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  winners              ContestDrawWinner[]

  @@index([pollId, createdAt])
  @@index([eventId, createdAt])
}

enum ContestWinnerStatus {
  ACTIVE
  REPLACED
}

model ContestDrawWinner {
  id                 String               @id @default(cuid())
  drawId             String
  pollId             String
  voterSessionId     String
  position           Int                  @default(0)
  firstName          String
  lastName           String?
  /** Nullable L1 : gagnant Concours email-only (D2). */
  phone              String?
  email              String?
  /** ACTIVE = gagnant courant ; REPLACED = historique (non affiché publiquement). */
  status             ContestWinnerStatus  @default(ACTIVE)
  replacedAt         DateTime?
  replacedByWinnerId String?
  createdAt          DateTime             @default(now())

  draw               ContestDraw          @relation(fields: [drawId], references: [id], onDelete: Cascade)
  poll               Poll                 @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([drawId, position])
  @@unique([pollId, voterSessionId])
  @@index([pollId, createdAt])
  @@index([pollId, status])
}

model PollOption {
  id       String  @id @default(cuid())
  pollId   String
  label    String
  order    Int     @default(0)
  imageUrl String?
  isCorrect Boolean @default(false)

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]
}

model Vote {
  id             String   @id @default(cuid())
  pollId         String
  optionId       String
  voterSessionId String
  createdAt      DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([pollId])
  @@index([optionId])
  @@index([pollId, voterSessionId])
}

model LeadCapture {
  id             String   @id @default(cuid())
  eventId        String
  pollId         String
  voterSessionId String
  /** Nullable L1 : templates sans prénom (ex. civic) — contraintes applicatives Concours. */
  firstName      String?
  lastName       String?
  /** Nullable L1 : Concours email-only (D2). */
  phone          String?
  email          String?
  /** Réponses dynamiques { [fieldId]: value }. */
  answers        Json?
  schemaVersion  Int?
  /** Preuve consentements RGPD (D7). */
  consents       Json?
  createdAt      DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  poll  Poll  @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([pollId, createdAt])
  @@unique([pollId, voterSessionId])
}

model AccountReportShareToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  fromDate   DateTime?
  toDate     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, revokedAt, expiresAt])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  stripeSessionId String   @unique
  amount          Int
  credits         Int
  createdAt       DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventActivations EventActivation[]

  @@index([userId, createdAt])
}

model EventActivation {
  id                String             @id @default(cuid())
  userId            String
  paymentId         String?
  planType          ActivationPlanType
  participantsLimit Int
  consumedAt        DateTime?
  createdAt         DateTime           @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId, consumedAt])
  @@index([userId, planType, consumedAt])
}
