# PostgreSQL — ex. postgresql://USER:PASSWORD@localhost:5432/avote
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/avote"
# Connexion directe (port 5432) pour `prisma migrate deploy` / Pre-deploy Railway.
# En local, peut être identique à DATABASE_URL. En prod Supabase : Direct, pas pooler 6543.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/avote"

# JWT cookies (auth admin). Minimum 16 caractères.
JWT_SECRET="change-me-at-least-16-chars"

# Front Next (CORS + cookies). Ex. http://localhost:3000
# En local, le front peut appeler cette API directement (NEXT_PUBLIC_API_BROWSER_BASE).
# CORS autorise déjà http://localhost:3000 et http://127.0.0.1:3000 (credentials).
# CLIENT_URL=http://localhost:3000
# Obligatoire en prod pour les liens « mot de passe oublié » :
# CLIENT_URL=https://www.avote.app

# E-mails transactionnels (reset mot de passe). Un seul transport suffit.
# MAIL_FROM="AVOTE <noreply@avote.app>"
# SMTP_URL="smtps://USER:PASS@smtp.example.com:465"
# RESEND_API_KEY=re_...
# Hors prod : sans SMTP/Resend, les mails sont loggés (MAIL_ALLOW_LOG=1 forcé si NODE_ENV≠production).
# MAIL_ALLOW_LOG=1
# MAIL_DEBUG_TOKEN=1

# Origine publique de cette API (sans slash final). Obligatoire en prod pour les URLs
# logo / fond (/uploads/...) renvoyées au client. Doit matcher l’URL utilisée dans NEXT_PUBLIC_API_URL.
# PUBLIC_API_ORIGIN="https://votre-api.example.com"

# Cloudinary (uploads persistants)
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...

# Stripe (paiement + webhook crédits)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_EVENT_1=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Mot de passe optionnel pour l’utilisateur legacy après migrate (seed).
# DEV_LEGACY_PASSWORD=devpassword
