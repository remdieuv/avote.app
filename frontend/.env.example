# --- API Express ---
# URL absolue backend (participant, Screen, Socket, assets, SSR).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Socket.IO (défaut = NEXT_PUBLIC_API_URL).
# NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --- Dev local Windows / hop Next→Express ---
# Obligatoire en développement local pour éviter EADDRINUSE via /api/backend :
# le navigateur appelle Express directement (CORS + cookies localhost).
# Ne PAS définir en production (Vercel) : laisser vide → défaut /api/backend.
NEXT_PUBLIC_API_BROWSER_BASE=http://localhost:4000

# Utiliser le hostname « localhost » partout (pas 127.0.0.1) pour les cookies.
